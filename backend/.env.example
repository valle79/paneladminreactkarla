# Copia este archivo a ".env" y completa con tu conexión de Neon.
# Obtén la CADENA de conexión en: Neon Console -> Databases -> Connection Details
# Usa la cadena de la pestaña "Node.js"/"Python" (NO la de "prisma" ni "drizzle").

DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Contraseña del panel administrativo (aparece al hacer login)
AUTH_PASSWORD=iqueño2026

# Secreto para firmar los tokens de sesión (cámbialo)
AUTH_SECRET=super-secreto-cambiar

# Puerto del backend
PORT=8000

# CORS: orígenes permitidos separados por coma (sin espacios).
# En PRODUCCIÓN usa los dominios reales del panel y de la web, NO "*".
# Ej: https://panel-iqueno-proformas.onrender.com,https://iquenosac.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173

# RENIEC / SUNAT (decolecta.com). Si dejas DECOLECTA_TOKEN vacio usa MODO DEMO
DECOLECTA_TOKEN=sk_xxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudinary (almacenamiento de imagenes/PDFs). Si dejas vacio usa la carpeta local uploads/
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase (fuente de datos para migrate_supabase_to_neon.py). La anon key es publica.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# WhatsApp Cloud API (Meta) - envia PDF/video adjuntos desde el panel.
# - WHATSAPP_TOKEN: System User access token (largo plazo) de developers.facebook.com
# - WHATSAPP_PHONE_ID: "Phone number ID" del numero de la empresa
# - WHATSAPP_API_VERSION: opcional (por defecto v23.0)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v23.0